# Data layers (raw/processed/analytics) are gitignored — they are downloaded
# or generated, and can be large. Small fixture files under tests/fixtures/
# are tracked normally since they are not covered by this rule.
data/raw/*
data/processed/*
data/analytics/*
!data/raw/.gitkeep
!data/processed/.gitkeep
!data/analytics/.gitkeep

# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Node / dashboard
dashboard/node_modules/
dashboard/dist/
dashboard/build/

# Env / secrets
.env
.env.*
!.env.example

# OS / editor
.DS_Store
.idea/
.vscode/
